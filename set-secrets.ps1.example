# 비밀 환경변수 설정 스크립트 (템플릿)
#
# 사용법:
#   1) 이 파일을 set-secrets.ps1 로 복사한다.   (복사본은 .gitignore 되어 커밋되지 않음)
#      PowerShell:  Copy-Item .\set-secrets.ps1.example .\set-secrets.ps1
#   2) 아래 변수에서 "아는 값만" 채운다. 비워두거나 <...> 그대로면 그 항목은 건너뛴다
#      (기존에 설정돼 있던 값은 그대로 보존 → 실수로 덮어쓰지 않음).
#   3) 관리자 PowerShell 에서 실행:   .\set-secrets.ps1
#   4) 서버/워커를 재시작한다.        .\stop_server.ps1 ; .\start_server.ps1  (워커도)
#
# 새 서버로 옮길 때는 값 채운 set-secrets.ps1 파일만 복사해 1회 실행하면 된다.
# env.ps1 은 여기서 저장한 시스템 환경변수를 읽어오므로 별도 수정이 필요 없다.

# 저장 범위: 관리자 권한이면 'Machine'(모든 사용자), 없으면 'User'(현재 사용자)
$Scope = 'Machine'

# ── 채울 값 (모르는/안 바꿀 항목은 <...> 그대로 두면 건너뜀) ──
$PgPassword = '<POSTGRES-비밀번호>'
$GeminiKey  = '<GEMINI-API-키>'
$GoogleKey  = '<GOOGLE-API-키>'   # 선택(없으면 그대로 두세요)

# ── 아래는 수정 불필요 ──
function Set-SecretIf([string]$Name, [string]$Value) {
    if ($Value -and ($Value -notmatch '^<.*>$')) {
        [Environment]::SetEnvironmentVariable($Name, $Value, $Scope)
        Write-Host "[OK]   $Name 저장 ($Scope)" -ForegroundColor Green
    } else {
        Write-Host "[skip] $Name — 값 미입력, 기존 값 유지" -ForegroundColor DarkGray
    }
}

Set-SecretIf 'REFERENCE_PG_PASSWORD' $PgPassword
Set-SecretIf 'GEMINI_API_KEY'        $GeminiKey
Set-SecretIf 'GOOGLE_API_KEY'        $GoogleKey

Write-Host "완료. 서버/워커를 재시작하면 반영됩니다." -ForegroundColor Cyan
