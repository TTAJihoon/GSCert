# PostgreSQL reference DB 접속 정보 (예시)
#
# 사용법: 이 파일을 같은 폴더에 env.ps1 로 복사한 뒤 실제 값으로 채우세요.
#   Copy-Item env.ps1.example env.ps1
# env.ps1 은 .gitignore 에 포함되어 있어 커밋되지 않습니다(비밀번호 보호).
#
# start_server.ps1 / start_worker.ps1 / launcher.ps1 / setup.ps1 시작 시 자동 로드됩니다.

$env:REFERENCE_PG_NAME     = "gscert_reference"
$env:REFERENCE_PG_USER     = "postgres"
$env:REFERENCE_PG_PASSWORD = "여기에_PostgreSQL_비밀번호"
$env:REFERENCE_PG_HOST     = "localhost"
$env:REFERENCE_PG_PORT     = "5432"
