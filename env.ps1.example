# PostgreSQL reference DB 접속 정보 (예시)
#
# 사용법: 이 파일을 같은 폴더에 env.ps1 로 복사한 뒤 실제 값으로 채우세요.
#   Copy-Item env.ps1.example env.ps1
# env.ps1 은 .gitignore 에 포함되어 있어 커밋되지 않습니다(비밀번호 보호).
#
# start_server.ps1 / start_worker.ps1 / launcher.ps1 / setup.ps1 시작 시 자동 로드됩니다.

$env:REFERENCE_PG_NAME     = "gscert_reference"
$env:REFERENCE_PG_USER     = "postgres"
$env:REFERENCE_PG_PASSWORD = "여기에_PostgreSQL_비밀번호"
$env:REFERENCE_PG_HOST     = "localhost"
$env:REFERENCE_PG_PORT     = "5432"

# LLM 모델 선택(키 값은 별도의 비밀 환경변수로 등록)
$env:GEMINI_API_KEY          = "여기에_Gemini_API_키"
$env:OPENAI_API_KEY          = "여기에_OpenAI_API_키"
$env:GSCERT_LLM_MODELS       = "google:gemma-4-26b-a4b-it,google:gemini-3.5-flash-lite,openai:gpt-5.6-luna"
$env:GSCERT_LLM_DEFAULT      = "google:gemma-4-26b-a4b-it"
$env:OPENAI_REASONING_EFFORT = "low"

# 서버 IP — 앱이 호스트 기반 센터 라우팅 / 점검규칙 소스 / 산출물 보관 경로 산출에 사용한다.
# 코드에 IP를 하드코딩하지 않으며, 설치 시 아래 변수로 주입한다.
#   MAIN_SERVER_IP : 주 서버 (PostgreSQL + 점검규칙 + 웹 네비게이션 홈 + 분당 워커)
#   SUB_SERVER_IP  : 서브 서버 (상암/영남 워커)
#   FILE_SHARE_HOST: 산출물 보관 공유폴더 호스트 (\\<host>\ecm)
# 서브 서버에서는 MAIN_SERVER_IP = (PG/규칙 소스인) 주 서버 IP, SUB_SERVER_IP = 이 서버 IP 로 둔다.
$env:MAIN_SERVER_IP  = "210.96.71.194"
$env:SUB_SERVER_IP   = "210.96.71.241"
$env:FILE_SHARE_HOST = "210.96.71.99"

# 194 의 공인 도메인(Cloudflare Tunnel 등으로 외부 서비스할 때). 설정하면 메인 앱을
# MAIN_SERVER_IP 뿐 아니라 이 도메인으로도 서비스한다(센터 라우팅 포함).
# nginx 쪽도 동일한 값을 써야 한다: setup/Update-NginxConf.ps1 이 이 변수를 읽는다.
# $env:SERVER_DOMAIN = "gsai.tta.or.kr"

# 점검규칙은 주 서버 PostgreSQL 에 저장되어 두 서버가 공유한다.
# 서브 서버에서는 위 REFERENCE_PG_HOST 를 주 서버 IP 로 두면 규칙을 직접 읽는다.

# --- ECM HTTP 직접연동 (산출물 다운로드, source=ecm-http) ---
# Destiny ECM 을 브라우저/에이전트 없이 서버에서 requests 로 직접 호출한다.
# 코드/DB 에 평문 비밀번호를 저장하지 않으므로 자격증명은 여기서만 주입한다.
# 상세: main/docs/34_http_ecm_source_decisions.md
#
# 상암·영남 공유 계정(서버 210.96.71.85):
$env:ECM_USERNAME         = "여기에_상암영남_ECM_ID"
$env:ECM_PASSWORD         = "여기에_상암영남_ECM_PW"
# 분당 별도 계정(서버 210.104.181.10):
$env:ECM_USERNAME_BUNDANG = "여기에_분당_ECM_ID"
$env:ECM_PASSWORD_BUNDANG = "여기에_분당_ECM_PW"
#
# source 를 HTTP 직접연동으로 쓰려면(안정화 전까지는 실행 단위로만 켠다):
#   $env:DOWNLOAD_REVIEW_SOURCE = "ecm-http"
# 문제가 생기면 Playwright 방식으로 즉시 롤백:  --source=ecm
#
# root OID / base URL 은 코드 기본값(분당 C_ROOT, 상암 1PQSYcuFhzv, 영남 1EBnGfHdFwe)을
# 쓰며, 실서버 값이 다르면 아래로 덮어쓴다:
# $env:ECM_ROOT_OID_SANGAM   = "1PQSYcuFhzv"
# $env:ECM_ROOT_OID_YEONGNAM = "1EBnGfHdFwe"
# $env:ECM_ROOT_OID_BUNDANG  = "C_ROOT"
